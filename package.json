{
  "name": "rex-mfe-demo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "sh ./start.sh",
    "dev": "npm run dev --workspace=shell",
    "dev:all": "concurrently \"npm run dev --workspace=shell\" \"npm run dev --workspace=marketplace\" \"npm run dev --workspace=cart\" \"npm run dev --workspace=account\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.10",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.14"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
